{
  "name": "legs-on",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "snapshot": "node --experimental-strip-types scripts/snapshot-feed.mjs",
    "predev": "node scripts/gen-content.mjs",
    "prebuild": "node scripts/gen-content.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:access": "node --experimental-strip-types scripts/test-access.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wrangler": "^4.168.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
